{
  "name": "wymap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate && prisma validate --schema=prisma/schema.postgres.prisma",
    "prisma:seed": "node prisma/seed.js",
    "prisma:migrate:sqlite": "prisma migrate dev --name init",
    "prisma:migrate:postgres": "prisma migrate dev --schema=prisma/schema.postgres.prisma --name init",
    "prisma:generate:postgres": "prisma generate --schema=prisma/schema.postgres.prisma",
    "test": "DATABASE_URL=\"file:./test.db\" AUTH_SECRET=\"test-secret\" prisma db push --force-reset && vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.2",
    "idb": "^8.0.3",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.28",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.9.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
