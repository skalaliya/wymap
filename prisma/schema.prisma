generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  SUPERVISOR
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum ClockEventType {
  IN
  OUT
  BREAK_START
  BREAK_END
}

enum ClockEventSource {
  KIOSK
  OFFLINE_SYNC
  ADMIN
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         UserRole   @default(ADMIN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?
  auditLogs    AuditLog[]
  corrections  Correction[]
  reviewedCorrections Correction[] @relation("CorrectionReview")
}

model Employee {
  id              String        @id @default(cuid())
  name            String
  status          EmployeeStatus @default(ACTIVE)
  badgeId         String?       @unique
  pinHash         String?
  tokenHash       String?
  tokenUpdatedAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  events          ClockEvent[]
}

model Site {
  id        String    @id @default(cuid())
  name      String
  timeZone  String    @default("UTC")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  devices   Device[]
  events    ClockEvent[]
}

model Device {
  id         String     @id @default(cuid())
  name       String
  siteId     String
  active     Boolean    @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  site       Site       @relation(fields: [siteId], references: [id])
  events     ClockEvent[]

  @@index([siteId])
}

model ClockEvent {
  id              String          @id @default(cuid())
  employeeId      String
  siteId          String
  deviceId        String
  type            ClockEventType
  source          ClockEventSource
  occurredAt      DateTime
  createdAt       DateTime        @default(now())
  idempotencyKey  String          @unique
  employee        Employee        @relation(fields: [employeeId], references: [id])
  site            Site            @relation(fields: [siteId], references: [id])
  device          Device          @relation(fields: [deviceId], references: [id])
  correctionLinks Correction[]    @relation("OriginalEvent")
  correctionEvent Correction?     @relation("CorrectionEvent")

  @@index([employeeId, occurredAt])
  @@index([deviceId, createdAt])
}

model Correction {
  id                 String     @id @default(cuid())
  originalEventId    String
  correctionEventId  String     @unique
  reason             String
  status             CorrectionStatus @default(PENDING)
  createdByUserId    String
  reviewedByUserId   String?
  reviewedAt         DateTime?
  createdAt          DateTime   @default(now())
  originalEvent      ClockEvent @relation("OriginalEvent", fields: [originalEventId], references: [id])
  correctionEvent    ClockEvent @relation("CorrectionEvent", fields: [correctionEventId], references: [id])
  createdBy          User       @relation(fields: [createdByUserId], references: [id])
  reviewedBy         User?      @relation("CorrectionReview", fields: [reviewedByUserId], references: [id])

  @@index([originalEventId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorUserId String?
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
}
